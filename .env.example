# Optional absolute paths. Defaults are relative to this starter, not the shell.
# INPUT_DIR=/absolute/path/to/closed-day-exports
# STATE_DIR=/absolute/path/to/daily-digest-state
# Leave both unset to use `npm run connect`. Otherwise provide both together.
# PINGROOM_TOKEN=your-agent-token
# PINGROOM_ROOM=your-room-code
# Optional dedicated saved credential directory; default: this starter's .pingroom
# PINGROOM_HOME=/absolute/path/to/digest-connection
